APP_NAME="ReadyToGo Staging"
APP_ENV=staging
APP_KEY=base64:GENERATE_KEY_DISINI
APP_DEBUG=true
APP_URL=http://staging.domain-anda.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=readytogo_db
DB_USERNAME=readytogo_user
DB_PASSWORD=secretpassword
DB_ROOT_PASSWORD=rootpassword

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
